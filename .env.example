# Copy to .env.local (never commit real values).

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only ---
# Service role bypasses RLS. Needed only for webhooks / scheduled jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meeting provider ---
# "mock" (default, demo mode) or "microsoft_teams". Teams requires every MS_* variable below.
MEETING_PROVIDER=mock

# --- Microsoft 365 / Entra ID (leave empty until the tenant exists) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Object id of the user that meetings are created for (must be covered by the application access policy)
MS_ORGANIZER_USER_ID=
# Long random secret that Graph echoes in every notification (e.g. `openssl rand -hex 32`)
MS_WEBHOOK_CLIENT_STATE=
# Public https origin of this app, e.g. https://dashboard.example.org (Graph cannot reach localhost)
MS_NOTIFICATION_BASE_URL=
# Optional. Subscription lifetime requested from Graph; maximum differs per resource type. Default 1440.
MS_SUBSCRIPTION_LIFETIME_MINUTES=

# Secret for the scheduled job at /api/cron/microsoft (sent as `Authorization: Bearer ...`)
CRON_SECRET=
